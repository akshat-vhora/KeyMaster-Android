                    shape = RoundedCornerShape(16.dp),
                    color = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.3f)
                ) {
                    Column(
                        Modifier
                            .fillMaxWidth()
                            .padding(start = 0.dp)) {
//                        Surface(
//                            color = MaterialTheme.colorScheme.primary.copy(alpha = 0.6f),
//                            modifier = Modifier
//                                .fillMaxWidth()
//                                .height(3.dp)
//                                .clip(RoundedCornerShape(topStart = 16.dp, topEnd = 16.dp))
//                        ) {}
                        Column(
                            Modifier.padding(12.dp, 10.dp, 12.dp, 10.dp),
                            verticalArrangement = Arrangement.spacedBy(8.dp)
                        ) {
//                            Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
//                                Text(
//                                    referral.code,
//                                    fontSize = 12.sp,
//                                    fontWeight = FontWeight.SemiBold,
//                                    letterSpacing = 1.sp,
//                                    color = MaterialTheme.colorScheme.primary
//                                )
//                                Spacer(Modifier.weight(1f))
//
//                            }
                            OutlinedTextField(
                                value = referral.code,
                                onValueChange = {},
                                readOnly = true,
                                label = { Text("Code") },
                                singleLine = true,
                                textStyle = LocalTextStyle.current.copy(
                                    fontFamily = FontFamily.Monospace,
                                    fontSize = 13.sp,
                                    letterSpacing = 1.sp
                                ),
                                trailingIcon = {
                                    IconButton(onClick = { copyText(context, "Referral code", referral.code) }) {
                                        Icon(
                                            Icons.Default.ContentCopy,
                                            null,
                                            Modifier.size(18.dp),
                                            tint = MaterialTheme.colorScheme.primary
                                        )
                                    }
                                },
                                shape = RoundedCornerShape(12.dp),
                                modifier = Modifier.fillMaxWidth()
                            )
                            Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
                                Row(Modifier.weight(1f), verticalAlignment = Alignment.CenterVertically) {
                                    Icon(
                                        Icons.Default.Person,
                                        null,
                                        Modifier.size(12.dp),
                                        tint = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.6f)
                                    )
                                    Spacer(Modifier.width(4.dp))
                                    Text(
                                        referral.createdBy,
                                        fontSize = 11.sp,
                                        color = MaterialTheme.colorScheme.onSurfaceVariant,
                                        maxLines = 1,
                                        overflow = TextOverflow.Ellipsis
                                    )
                                    Spacer(Modifier.width(4.dp))
                                    Text(
                                        "Grant ${referral.setSaldo}",
                                        fontSize = 11.sp,
                                        fontWeight = FontWeight.Medium,
                                        color = MaterialTheme.colorScheme.onSurfaceVariant
                                    )
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
private fun AdminConsoleScreen(state: PanelUiState, vm: PanelViewModel) {
    val context = LocalContext.current
    val edit = state.adminEdit
    LazyColumn(
        contentPadding = PaddingValues(16.dp),
        verticalArrangement = Arrangement.spacedBy(14.dp)
    ) {
        item {
            OutlinedTextField(
                value = state.adminSearch,
                onValueChange = vm::updateAdminSearch,
                label = { Text("Search platform users") },
                leadingIcon = { Icon(Icons.Default.Search, null) },
                singleLine = true,
                modifier = Modifier.fillMaxWidth()
            )
        }
        items(state.adminUsers, key = { it.idUsers }) { user ->
            val statusActive = user.status == 1
            val statusColor = if (statusActive) Color(0xFF22C55E) else Color(0xFFA1A1AA)
            val levelLabel = if (user.level == 1) "Admin" else "Reseller"
            val initial = user.username.firstOrNull()?.uppercase() ?: "?"

            Card(
                modifier = Modifier.fillMaxWidth(),
                shape = RoundedCornerShape(14.dp),
                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.3f))
            ) {
                Row(
                    Modifier.padding(16.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Box(
                        Modifier
                            .size(48.dp)
                            .clip(CircleShape)
                            .background(if (statusActive) Color(0xFF22C55E).copy(alpha = 0.12f) else MaterialTheme.colorScheme.surfaceVariant),
                        contentAlignment = Alignment.Center
                    ) {
                        Text(
                            initial,
                            fontWeight = FontWeight.Bold,
                            fontSize = 20.sp,
                            color = if (statusActive) Color(0xFF22C55E) else MaterialTheme.colorScheme.onSurfaceVariant
                        )
                    }
                    Spacer(Modifier.width(14.dp))
                    Column(Modifier.weight(1f)) {
                        Row(verticalAlignment = Alignment.CenterVertically) {
                            Text(
                                user.username,
                                fontWeight = FontWeight.SemiBold,
                                fontSize = 15.sp,
                                maxLines = 1,
                                overflow = TextOverflow.Ellipsis,
                                modifier = Modifier.weight(1f, fill = false)
                            )
                            Spacer(Modifier.width(6.dp))
                            Surface(
                                shape = RoundedCornerShape(4.dp),
                                color = MaterialTheme.colorScheme.primary.copy(alpha = 0.1f)
                            ) {
                                Text(
                                    levelLabel,
                                    fontSize = 10.sp,
                                    fontWeight = FontWeight.Medium,
                                    color = MaterialTheme.colorScheme.primary,
                                    modifier = Modifier.padding(horizontal = 6.dp, vertical = 2.dp)
                                )
                            }
                        }
                        Spacer(Modifier.height(3.dp))
                        Text(
                            user.email.ifBlank { "No email" },
                            fontSize = 13.sp,
                            color = MaterialTheme.colorScheme.onSurfaceVariant,
                            maxLines = 1,
                            overflow = TextOverflow.Ellipsis
                        )
                    }
                    Spacer(Modifier.width(8.dp))
                    Column(horizontalAlignment = Alignment.End) {
                        Text(
                            "${user.saldo}",
                            fontWeight = FontWeight.Bold,
                            fontSize = 16.sp,
                            color = MaterialTheme.colorScheme.onSurface
                        )
                        Text(
                            "saldo",
                            fontSize = 9.sp,
                            color = MaterialTheme.colorScheme.onSurfaceVariant
                        )
                    }
                }
                HorizontalDivider(
                    color = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.4f),
                    modifier = Modifier.padding(horizontal = 16.dp)
                )
                Row(
                    Modifier.fillMaxWidth().padding(horizontal = 12.dp, vertical = 4.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Box(Modifier.size(8.dp).clip(CircleShape).background(statusColor))
                    Spacer(Modifier.width(4.dp))
                    Text(
                        if (statusActive) "Active" else "Inactive",
                        fontSize = 12.sp,
                        color = statusColor
                    )
                    Spacer(Modifier.weight(1f))
                    TextButton(
                        onClick = { vm.showAdminEdit(user) },
                        contentPadding = PaddingValues(horizontal = 8.dp, vertical = 4.dp)
                    ) {
                        Icon(Icons.Default.Edit, null, Modifier.size(16.dp))
                        Spacer(Modifier.width(4.dp))
                        Text("Edit", fontSize = 12.sp)
                    }
                    TextButton(
                        onClick = { vm.requestConfirm("deleteAdmin", user = user) },
                        colors = ButtonDefaults.textButtonColors(contentColor = MaterialTheme.colorScheme.error),
                        contentPadding = PaddingValues(horizontal = 8.dp, vertical = 4.dp)
                    ) {
                        Icon(Icons.Default.Delete, null, Modifier.size(16.dp))
                        Spacer(Modifier.width(4.dp))
                        Text("Delete", fontSize = 12.sp)
                    }
                }
            }
        }
    }
    if (edit != null) {
        ModalBottomSheet(onDismissRequest = { vm.showAdminEdit(null) }) {
            Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
                Text(
                    "Edit ${edit.user.username}",
                    style = MaterialTheme.typography.titleLarge,
                    fontWeight = FontWeight.Bold
                )
                OutlinedTextField(
                    value = edit.username,
                    onValueChange = {},
                    readOnly = true,
                    label = { Text("Username") },
                    singleLine = true,
                    modifier = Modifier.fillMaxWidth()
                )
                OutlinedTextField(
                    value = edit.email,
                    onValueChange = {},
                    readOnly = true,
                    label = { Text("Email") },
                    singleLine = true,
                    modifier = Modifier.fillMaxWidth()
                )
                PanelTextField(edit.saldo, { vm.updateAdminEdit(edit.copy(saldo = it)) }, "Saldo")
                PanelTextField(edit.level, { vm.updateAdminEdit(edit.copy(level = it)) }, "Level")
                Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
                    Text("Status", modifier = Modifier.weight(1f))
                    Switch(
                        checked = edit.status,
                        onCheckedChange = { vm.updateAdminEdit(edit.copy(status = it)) }
                    )
                }
                Button(
                    onClick = vm::saveAdminUser,
                    enabled = !state.loading,
                    modifier = Modifier.fillMaxWidth()
                ) {
                    Text("Save user")
                }
                Spacer(Modifier.height(24.dp))
            }
        }
    }
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
private fun ManageGamesScreen(state: PanelUiState, vm: PanelViewModel) {
    var showAddDialog by remember { mutableStateOf(false) }
    var newCode by remember { mutableStateOf("") }
    var newDisplayName by remember { mutableStateOf("") }
    var newLibName by remember { mutableStateOf("") }
    val context = LocalContext.current
    var gameToDelete by remember { mutableStateOf<String?>(null) }
    var selectedGameForEdit by remember { mutableStateOf<GameItem?>(null) }
    var filePickerGameCode by remember { mutableStateOf<String?>(null) }
    var editDisplayName by remember { mutableStateOf("") }
    var editLibName by remember { mutableStateOf("") }

    val filePickerLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.GetContent(),
        onResult = { uri ->
            uri?.let {
                val targetGameCode = filePickerGameCode
                filePickerGameCode = null
                val game = state.games.firstOrNull { g -> g.code == targetGameCode } ?: return@let
                val libName = game.libName.trim()
                if (libName.isBlank()) return@let
                val token = state.token ?: return@let
                try {
                    val inputStream = context.contentResolver.openInputStream(it)
                    val bytes = inputStream?.readBytes() ?: return@let
                    inputStream.close()
                    if (bytes.size > 10 * 1024 * 1024) {
                        vm.setError("File exceeds 10MB limit")
                        return@let
                    }
                    vm.uploadLib(token, bytes, libName)
                    selectedGameForEdit = null
                } catch (_: Exception) {}
            }
        }
    )

    Column(Modifier.fillMaxSize()) {
        LazyColumn(
            contentPadding = PaddingValues(16.dp),
            verticalArrangement = Arrangement.spacedBy(12.dp)
        ) {
            if (state.profile?.level == 1) {
                item {
                    Button(
                        onClick = {
                            newCode = ""
                            newDisplayName = ""
                            newLibName = ""
                            showAddDialog = true
                        },
                        modifier = Modifier.fillMaxWidth()
                    ) {
                        Icon(Icons.Default.Add, null, Modifier.size(18.dp))
                        Spacer(Modifier.width(8.dp))
                        Text("Add Game")
                    }
                }
            }
            if (state.games.isEmpty()) {
                item {
                    Column(
                        Modifier.fillMaxWidth().padding(vertical = 48.dp),
                        horizontalAlignment = Alignment.CenterHorizontally
                    ) {
                        Icon(Icons.Default.SportsEsports, null, Modifier.size(48.dp), tint = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.4f))
                        Spacer(Modifier.height(12.dp))
                        Text("No games loaded", color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.6f), fontSize = 14.sp)
                    }
                }
            } else {
                items(state.games, key = { it.code }) { game ->
                    val avatarColor = remember(game.code) {
                        val hash = game.code.hashCode()
                        val hue = ((hash % 360) + 360) % 360
                        Color.hsl(hue.toFloat(), 0.55f, 0.45f)
                    }
                    ElevatedCard(
                        onClick = {
                            selectedGameForEdit = game
                            editDisplayName = game.displayName
                            editLibName = game.libName
                        },
                        colors = CardDefaults.elevatedCardColors(
                            containerColor = if (game.active)
                                MaterialTheme.colorScheme.surface
                            else
                                MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.4f)
                        ),
                        modifier = Modifier.fillMaxWidth()
                    ) {
                        Row(
                            Modifier.fillMaxWidth().padding(14.dp),
                            verticalAlignment = Alignment.CenterVertically
                        ) {
                            Box(
                                modifier = Modifier
                                    .size(46.dp)
                                    .clip(CircleShape)
                                    .background(avatarColor.copy(alpha = 0.12f)),
                                contentAlignment = Alignment.Center
                            ) {
                                Text(
                                    text = game.code.take(2).uppercase(),
                                    fontWeight = FontWeight.ExtraBold,
                                    fontSize = 15.sp,
                                    color = avatarColor
                                )
                            }
                            Spacer(Modifier.width(14.dp))
                            Column(Modifier.weight(1f)) {
                                Text(
                                    game.displayName,
                                    fontWeight = FontWeight.SemiBold,
                                    fontSize = 15.sp,
                                    maxLines = 1,
                                    overflow = TextOverflow.Ellipsis
                                )
                                Spacer(Modifier.height(3.dp))
                                Row(verticalAlignment = Alignment.CenterVertically) {
                                    Text(
                                        game.code,
                                        fontFamily = FontFamily.Monospace,
                                        fontSize = 11.sp,
                                        color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.7f)
                                    )
                                    if (game.libName.isNotBlank()) {
                                        Spacer(Modifier.width(6.dp))
                                        Box(
                                            Modifier
                                                .size(3.dp)
                                                .clip(CircleShape)
                                                .background(MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.3f))
                                        )
                                        Spacer(Modifier.width(6.dp))
                                        Text(
                                            game.libName,
                                            fontSize = 10.sp,
                                            color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.5f),
                                            maxLines = 1,
                                            overflow = TextOverflow.Ellipsis,
                                            modifier = Modifier.widthIn(max = 100.dp)
                                        )
                                    }
                                }
                            }
                            Surface(
                                shape = RoundedCornerShape(6.dp),
                                color = if (game.active) Color(0xFF10B981).copy(alpha = 0.12f) else MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.5f)
                            ) {
                                Text(
                                    text = if (game.active) "ON" else "OFF",
                                    modifier = Modifier.padding(horizontal = 8.dp, vertical = 4.dp),
                                    fontSize = 10.sp,
                                    fontWeight = FontWeight.Bold,
                                    color = if (game.active) Color(0xFF10B981) else MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.6f)
                                )
                            }
                        }
                    }
                }
            }
        }
    }

    if (showAddDialog) {
        val sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true)
        ModalBottomSheet(
            onDismissRequest = { showAddDialog = false },
            sheetState = sheetState
        ) {
            Column(
                Modifier.padding(16.dp).padding(bottom = 32.dp),
                verticalArrangement = Arrangement.spacedBy(12.dp)
            ) {
                Text("Add Game", fontWeight = FontWeight.Bold, fontSize = 18.sp)
                OutlinedTextField(
                    value = newCode,
                    onValueChange = {
                        newCode = it.uppercase().filter { c -> c.isLetterOrDigit() || c == '_' }.take(20)
                    },
                    label = { Text("Code") },
                    singleLine = true,
                    modifier = Modifier.fillMaxWidth()
                )
                OutlinedTextField(
                    value = newDisplayName,
                    onValueChange = { newDisplayName = it.take(60) },
                    label = { Text("Display name") },
                    singleLine = true,
                    modifier = Modifier.fillMaxWidth()
                )
                OutlinedTextField(
                    value = newLibName,
                    onValueChange = { newLibName = it.filter { c -> c.isLetterOrDigit() || c == '_' || c == '-' || c == '.' }.take(64) },
                    label = { Text("Lib name") },
                    placeholder = { Text("e.g. libcocos2dlua.so") },
                    singleLine = true,
                    modifier = Modifier.fillMaxWidth()
                )
                Button(
                    onClick = {
                        if (newCode.length >= 2 && newDisplayName.isNotBlank()) {
                            vm.createGame(newCode.uppercase(), newDisplayName.trim(), newLibName.trim())
                            showAddDialog = false
                        }
                    },
                    enabled = newCode.length >= 2 && newDisplayName.isNotBlank(),
                    modifier = Modifier.fillMaxWidth()
                ) { Text("Create") }
            }
        }
    }

    selectedGameForEdit?.let { game ->
        ModalBottomSheet(
            onDismissRequest = { selectedGameForEdit = null },
            sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true)
        ) {
            Column(
                Modifier.padding(16.dp).padding(bottom = 32.dp),
                verticalArrangement = Arrangement.spacedBy(12.dp)
            ) {
                var editActive by remember { mutableStateOf(game.active) }
                Text("Edit ${game.code}", fontWeight = FontWeight.Bold, fontSize = 18.sp)

                OutlinedTextField(
                    value = editDisplayName,
                    onValueChange = { editDisplayName = it.take(60) },
                    label = { Text("Display name") },
                    singleLine = true,
                    modifier = Modifier.fillMaxWidth()
                )
                OutlinedTextField(
                    value = editLibName,
                    onValueChange = { editLibName = it.filter { c -> c.isLetterOrDigit() || c == '_' || c == '-' || c == '.' }.take(64) },
                    label = { Text("Lib name") },
                    placeholder = { Text("e.g. libcocos2dlua.so") },
                    singleLine = true,
                    modifier = Modifier.fillMaxWidth()
                )
                Row(
                    Modifier.fillMaxWidth(),
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.SpaceBetween
                ) {
                    Text("Active", fontWeight = FontWeight.Medium)
                    Switch(
                        checked = editActive,
                        onCheckedChange = { editActive = it }
                    )
                }

                if (state.profile?.level == 1) {
                    OutlinedButton(
                        onClick = {
                            filePickerGameCode = game.code
                            filePickerLauncher.launch("application/octet-stream")
                        },
                        modifier = Modifier.fillMaxWidth(),
                        shape = RoundedCornerShape(10.dp),
                        enabled = game.libName.isNotBlank()
                    ) {
                        Text(if (game.libName.isNotBlank()) "Upload lib as ${game.libName}" else "Set lib name first")
                    }
                }

                Row(
                    Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    if (state.profile?.level == 1) {
                        OutlinedButton(
                            onClick = {
                                gameToDelete = game.code
                                selectedGameForEdit = null
                            },
                            modifier = Modifier.weight(1f),
                            shape = RoundedCornerShape(10.dp),
                            colors = ButtonDefaults.outlinedButtonColors(contentColor = MaterialTheme.colorScheme.error)
                        ) {
                            Icon(Icons.Default.Delete, null, Modifier.size(16.dp))
                            Spacer(Modifier.width(4.dp))
                            Text("Delete")
                        }

                        Button(
                            onClick = {
                                vm.updateGame(game.code, displayName = editDisplayName.trim(), libName = editLibName.trim(), active = editActive)
                                selectedGameForEdit = null
                            },
                            modifier = Modifier.weight(1f),
                            shape = RoundedCornerShape(10.dp)
                        ) {
                            Text("Save")
                        }
                    }
                }
            }
        }
    }

    gameToDelete?.let { code ->
        AlertDialog(
            onDismissRequest = { gameToDelete = null },
            shape = RoundedCornerShape(20.dp),
            containerColor = MaterialTheme.colorScheme.surface,
            title = { Text("Delete game", fontWeight = FontWeight.Bold) },
            text = { Text("Delete game \"$code\"? This cannot be undone.") },
            confirmButton = {
                Button(
                    onClick = { gameToDelete = null; vm.deleteGame(code) },
                    shape = RoundedCornerShape(12.dp),
                    colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.error)
                ) { Text("Delete") }
            },
            dismissButton = {
                TextButton(onClick = { gameToDelete = null }) { Text("Cancel") }
            }
        )
    }
    if (state.overwriteLibName != null) {
        AlertDialog(
            onDismissRequest = vm::dismissOverwriteLib,
            shape = RoundedCornerShape(20.dp),
            containerColor = MaterialTheme.colorScheme.surface,
            title = { Text("Lib already exists", fontWeight = FontWeight.Bold) },
            text = { Text("${state.overwriteLibName?.removeSuffix(".so") ?: ""}.so already exists in storage. Overwrite it?") },
            confirmButton = {
                Button(
                    onClick = vm::confirmOverwriteLib,
                    shape = RoundedCornerShape(12.dp)
                ) { Text("Overwrite") }
            },
            dismissButton = {
                TextButton(onClick = vm::dismissOverwriteLib) { Text("Cancel") }
            }
        )
    }
    if (state.uploadProgress >= 0) {
        AlertDialog(
            onDismissRequest = {},
            shape = RoundedCornerShape(20.dp),
            containerColor = MaterialTheme.colorScheme.surface,
            title = { Text("Uploading lib", fontWeight = FontWeight.Bold) },
            text = {
                Column(horizontalAlignment = Alignment.CenterHorizontally, modifier = Modifier.fillMaxWidth()) {
                    CircularProgressIndicator(
                        progress = { state.uploadProgress / 100f },
                        modifier = Modifier.size(64.dp),
                        strokeWidth = 6.dp
                    )
                    Spacer(Modifier.height(12.dp))
                    Text("${state.uploadProgress}%", fontWeight = FontWeight.Bold, fontSize = 18.sp)
                }
            },
            confirmButton = {}
        )
    }
}

@Composable
private fun StatCard(
    label: String,
    value: String,
    icon: ImageVector,
    modifier: Modifier = Modifier
) {
    ElevatedCard(modifier) {
        Column(
            Modifier.padding(10.dp),
            verticalArrangement = Arrangement.spacedBy(2.dp),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(4.dp)) {
                Icon(icon, null, Modifier.size(14.dp), tint = MaterialTheme.colorScheme.primary)
                Text(label, fontSize = 10.sp, color = MaterialTheme.colorScheme.onSurfaceVariant)
            }
            Text(value, fontSize = 20.sp, fontWeight = FontWeight.Black)
        }
    }
}

@Composable
private fun UseCaseCard(title: String, body: String, icon: ImageVector, onClick: () -> Unit) {
    Card(
        onClick = onClick,
        shape = RoundedCornerShape(24.dp),
        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.primaryContainer)
    ) {
        Row(
            Modifier
                .fillMaxWidth()
                .padding(16.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Icon(icon, null, tint = MaterialTheme.colorScheme.onPrimaryContainer)
            Spacer(Modifier.width(12.dp))
            Column {
                Text(
                    title,
                    fontWeight = FontWeight.Bold,
                    color = MaterialTheme.colorScheme.onPrimaryContainer
                )
                Text(body, color = MaterialTheme.colorScheme.onPrimaryContainer.copy(alpha = 0.75f))
            }
        }
    }
}

@Composable
private fun SectionTitle(text: String) {
    Text(text, style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.Bold)
}

@Composable
private fun EmptyCard(text: String) {
    Card(Modifier.fillMaxWidth()) {
        Text(text, Modifier.padding(18.dp), color = MaterialTheme.colorScheme.onSurfaceVariant)
    }
}

@Composable
private fun PanelTextField(
    value: String,
    onValueChange: (String) -> Unit,
    label: String,
    password: Boolean = false
) {
    val keyboardType = when {
        password -> KeyboardType.Password
        label.contains("email", ignoreCase = true) -> KeyboardType.Email
        label.contains("saldo", ignoreCase = true) ||
                label.contains("level", ignoreCase = true) ||
                label.contains("grant", ignoreCase = true) -> KeyboardType.Number

        else -> KeyboardType.Text
    }
    OutlinedTextField(
        value = value,
        onValueChange = onValueChange,
        label = { Text(label) },
        singleLine = true,
        keyboardOptions = KeyboardOptions(keyboardType = keyboardType),
        visualTransformation = if (password) PasswordVisualTransformation() else VisualTransformation.None,
        modifier = Modifier.fillMaxWidth()
    )
}

@Composable
private fun ChipGroup(items: List<String>, selected: String, onSelected: (String) -> Unit) {
    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
        items.chunked(3).forEach { row ->
            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                row.forEach { item ->
                    FilterChip(
                        selected = item == selected,
                        onClick = { onSelected(item) },
                        label = { Text(item) })
                }
            }
        }
    }
}

private fun standingLabel(profile: UserProfile?): String {
    return when (profile?.status) {
        1 -> "Active"
        0 -> "Limited"
        else -> "Unknown"
    }
}

private fun maskKey(key: String): String =
    if (key.length <= 6) "••••••" else key.take(5) + "••••" + key.takeLast(3)

private fun formatTimestamp(iso: String?): String {
    if (iso == null) return "-"
    return try {
        val instant = java.time.Instant.parse(iso)
        val local = instant.atZone(java.time.ZoneId.systemDefault())
        local.format(java.time.format.DateTimeFormatter.ofPattern("MMM dd, HH:mm"))
    } catch (_: Exception) {
        iso.take(16)
    }
}

private fun deviceCount(devices: String?): Int =
    devices?.split(",")?.filter { it.isNotBlank() }?.size ?: 0

private fun copyText(context: Context, label: String, value: String) {
    val clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
    clipboard.setPrimaryClip(ClipData.newPlainText(label, value))
}

private fun isValidEmail(value: String): Boolean {
    return value.length in 5..120 && value.contains("@") && value.substringAfter("@").contains(".")
}

private fun isValidUsername(value: String): Boolean {
    return value.length in 3..32 && value.all { it.isLetterOrDigit() || it == '_' }
}
